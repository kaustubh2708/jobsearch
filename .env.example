# Optional free API keys. Everything works without them — these just add coverage.
# Copy to .env and fill in whichever you want.

# Adzuna — real India job coverage, free tier, instant signup
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — aggregates Indian boards, free key by email
# https://jooble.org/api/about
JOOBLE_KEY=

# The Muse — works without a key, higher limits with one
# https://www.themuse.com/developers/api/v2
THEMUSE_KEY=
